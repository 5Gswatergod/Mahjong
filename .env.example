PORT=4000
WEB_ORIGIN=http://localhost:5173

# Optional persistence. Use DATABASE_URL, or let the server build the
# connection from POSTGRES_* variables. If all are omitted, room events
# are kept in memory only.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mahjong
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mahjong
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
